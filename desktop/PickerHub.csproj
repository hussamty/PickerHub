<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PickerHub</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23"/>
    <PackageReference Include="Tmds.DBus" Version="0.95.2"/>
    <AvaloniaResource Include="Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)"/>
    <AvaloniaResource Include="Icons/*.svg"/>
    <AvaloniaResource Include="Assets/icon-small-128.png;Assets/icon-64.png;Assets/icon-256.png;Assets/icon.svg"/>
    <EmbeddedResource Include="Localization.en.json" WithCulture="false" LogicalName="PickerHub.Localization.en.json"/>
  </ItemGroup>
</Project>
